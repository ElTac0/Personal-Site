<pre id="ascii-globe" aria-hidden="true"></pre>

<style>
	#ascii-globe {
		margin: 0;
		margin-inline: auto;
		width: fit-content;
		position: relative;
		color: rgb(32, 220, 128);
		font-family: 'Inconsolata', monospace;
		font-size: 3vmin;
		line-height: 0.55em;
		white-space: pre;
		isolation: isolate;
	}
	#ascii-globe::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: 100%;
		background-image: radial-gradient(
			circle farthest-corner at 75% 75%,
			rgba(0, 0, 16, 1) 0%,
			rgba(0, 16, 32, 1) 50%,
			rgba(0, 64, 48, 1) 100%
		);
		opacity: 0;
		transition: opacity 1s ease;
	}

	#ascii-globe.is-revealing::before {
		opacity: 1;
	}
</style>

<script>
	import * as THREE from 'three';

	const TEXTURE = '/earth.jpg';
	const WIDTH = 48;
	const HEIGHT = 48;
	const ASCII = '   ·—+=##';

	const FRAME_COUNT = 120;
	const PLAY_FPS = 15;
	const PLAY_MS = 1000 / PLAY_FPS;
	const REVEAL_MS = 1000;
	const START_ANGLE = 1.5;
	const BLANK_ROW = ' '.repeat(WIDTH);

	const el = document.getElementById('ascii-globe');
	if (!(el instanceof HTMLElement))
		throw new Error('ASCII globe element not found');
	const output: HTMLElement = el;

	const reducedMotion = window.matchMedia(
		'(prefers-reduced-motion: reduce)',
	).matches;

	output.textContent = Array(HEIGHT).fill(BLANK_ROW).join('\n');

	const frameRows: string[][] = [];
	const frameText: string[] = [];

	const scene = new THREE.Scene();
	const camera = new THREE.PerspectiveCamera(1, WIDTH / HEIGHT, 0.1, 1000);
	camera.position.z = 345;

	const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
	renderer.setPixelRatio(1);
	renderer.setSize(WIDTH, HEIGHT);

	const geometry = new THREE.SphereGeometry(3, 64, 48);
	const material = new THREE.MeshStandardMaterial({
		color: 0xffffff,
		roughness: 1,
		metalness: 1,
	});
	const globe = new THREE.Mesh(geometry, material);
	globe.rotation.z = Math.PI;
	scene.add(globe);

	const light = new THREE.PointLight(0xffffff, 3.33 * Math.PI, 0, 0);
	light.position.set(150, -150, 1500);
	scene.add(light);

	const light2 = new THREE.PointLight(0xffffff, 2 * Math.PI, 0, 0);
	light2.position.set(-125, 100, -500);
	scene.add(light2);

	const gl = renderer.getContext();
	const pixels = new Uint8Array(WIDTH * HEIGHT * 4);

	function renderFrame(index: number) {
		globe.rotation.y = START_ANGLE - (index / FRAME_COUNT) * Math.PI * 2;
		renderer.render(scene, camera);
		gl.readPixels(0, 0, WIDTH, HEIGHT, gl.RGBA, gl.UNSIGNED_BYTE, pixels);

		const rows: string[] = [];
		for (let y = 0; y < HEIGHT; y++) {
			let row = '';
			for (let x = WIDTH - 1; x >= 0; x--) {
				const i = (y * WIDTH + x) * 4;
				const brightness = (pixels[i] + pixels[i + 1] + pixels[i + 2]) / 768;
				row += ASCII[Math.floor(brightness * ASCII.length)];
			}
			rows.push(row);
		}

		frameRows.push(rows);
		frameText.push(rows.join('\n'));
	}

	function shutDownRenderer() {
		geometry.dispose();
		material.dispose();
		material.map?.dispose();
		renderer.dispose();
		renderer.forceContextLoss();
	}

	function generateFrames() {
		const target = reducedMotion ? 1 : FRAME_COUNT;

		const step = () => {
			renderFrame(frameText.length);
			if (frameText.length === 1) onFirstFrame();

			if (frameText.length < target) {
				requestAnimationFrame(step);
			} else {
				shutDownRenderer();
			}
		};

		requestAnimationFrame(step);
	}

	new THREE.TextureLoader().load(TEXTURE, (texture) => {
		material.map = texture;
		material.needsUpdate = true;
		generateFrames();
	});

	let visibleRows = 0;
	let revealStart: number | null = null;
	let playIndex = 0;
	let lastFrame = 0;
	let rafId: number | null = null;
	let onScreen = true;
	let doneFired = false;
	let stillPending = false;

	function fireDone() {
		if (doneFired) return;
		doneFired = true;
		document.dispatchEvent(new CustomEvent('globe:done'));
	}

	function maskRows(rows: string[]): string {
		return rows.map((row, y) => (y < visibleRows ? row : BLANK_ROW)).join('\n');
	}

	function loop(now: number) {
		rafId = requestAnimationFrame(loop);

		if (now - lastFrame < PLAY_MS) return;
		lastFrame = now;

		if (frameText.length === 0) return;

		if (revealStart !== null) {
			const progress = Math.min((now - revealStart) / REVEAL_MS, 1);
			visibleRows = Math.ceil(progress * HEIGHT);
			if (progress === 1) fireDone();
		}

		const i = playIndex % frameText.length;
		playIndex = (playIndex + 1) % FRAME_COUNT;

		output.textContent =
			visibleRows >= HEIGHT ? frameText[i] : maskRows(frameRows[i]);
	}

	function start() {
		if (rafId !== null || !onScreen || reducedMotion) return;
		lastFrame = performance.now();
		rafId = requestAnimationFrame(loop);
	}

	function stop() {
		if (rafId === null) return;
		cancelAnimationFrame(rafId);
		rafId = null;
	}

	function showStill() {
		output.classList.add('is-revealing');
		if (frameText.length === 0) {
			stillPending = true;
			return;
		}
		output.textContent = frameText[0];
		fireDone();
	}

	function onFirstFrame() {
		if (stillPending) {
			stillPending = false;
			showStill();
		}
	}

	function beginReveal() {
		output.classList.add('is-revealing');
		if (revealStart !== null) return;
		if (reducedMotion) {
			revealStart = 0;
			showStill();
			return;
		}
		revealStart = performance.now();
		start();
	}

	function skipReveal() {
		output.classList.add('is-revealing');
		if (reducedMotion) {
			showStill();
			return;
		}
		revealStart = performance.now() - REVEAL_MS;
		start();
	}

	const observer = new IntersectionObserver((entries) => {
		onScreen = entries[0]?.isIntersecting ?? true;
		if (!onScreen) stop();
		else if (revealStart !== null) start();
	});
	observer.observe(output);

	if (document.documentElement.dataset.typewriterDone === 'true') {
		beginReveal();
	} else {
		document.addEventListener('typewriter:done', beginReveal, { once: true });
	}
	document.addEventListener('intro:skip', skipReveal);
</script>

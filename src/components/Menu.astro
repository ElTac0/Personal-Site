---
import { navItems } from '../data/nav';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<nav aria-label="Main">
	<ul>
		{navItems.map((item) => (
			<li>
				<a
					href={item.href}
					aria-current={currentPath === item.href ? 'page' : undefined}
					target={item.external ? '_blank' : undefined}
					rel={item.external ? 'noopener noreferrer' : undefined}
				>
					{item.label}
					{item.external && <span class="sr-only">(opens in new tab)</span>}
				</a>
			</li>
		))}
	</ul>
</nav>

<style>
	nav {
		display: flex;
	}

	ul {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		list-style: none;
		padding: 0;
		margin: 0;
		width: fit-content; /* #2: as wide as the widest item */
	}

	a {
		display: block; /* #2: fill the row so every bar is the same width */
		text-decoration: none;
		padding: 0.25rem 1rem;
		color: var(--color-text);
		font-family: var(--font-display);
	}

	a::before {
		content: '>';
		margin-right: 0.5rem;
		opacity: 0;
	}

	/* #4: arrow on external links (alt text "" hides it from screen readers) */
	a[target='_blank']::after {
		content: '↗';
		content: '↗' / '';
		margin-left: 0.5rem;
	}

	/* Current page */
	a[aria-current='page'] {
		color: var(--color-text-bright);
	}

	a:hover::before,
	a:focus-visible::before,
	a[aria-current='page']::before {
		opacity: 1;
	}

	/* Inverted highlight */
	a:hover,
	a:focus-visible {
		background-color: var(--color-highlight-bg);
		color: var(--color-highlight-text);
		text-shadow: none;
		outline: 2px solid transparent; /* #3: shows up in high contrast mode */
	}

	/* #4: readable by screen readers, invisible on screen */
</style>

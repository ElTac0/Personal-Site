<div id="vhs" aria-hidden="true">
	<canvas id="vhs-noise"></canvas>
	<div class="scanlines"></div>
	<div class="tracking"></div>
</div>

<style>
	#vhs {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 9999;
		background: var(--color-bg);
		pointer-events: none;
		transition-property: opacity;
		transition-timing-function: ease;
		/* duration is set from the script */
	}

	:global(.js) #vhs {
		display: block;
	}

	#vhs.fade {
		opacity: 0;
	}

	#vhs-noise {
		width: 100%;
		height: 100%;
		image-rendering: pixelated;
		opacity: 0.85;
	}

	.scanlines {
		position: absolute;
		inset: 0;
		background: repeating-linear-gradient(
			to bottom,
			rgba(0, 0, 0, 1) 0 1px,
			transparent 1px 3px
		);
	}

	.tracking {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 12%;
		background: linear-gradient(
			transparent,
			color-mix(in srgb, var(--color-text) 40%, transparent),
			transparent
		);
		animation: roll 3.5s linear infinite;
	}

	@keyframes roll {
		from {
			transform: translateY(-100%);
		}
		to {
			transform: translateY(100vh);
		}
	}
</style>

<script>
	// ---- Settings ----
	const STATIC_MS = 1500; // how long the static plays
	const FADE_MS = 500; // how long the fade-out takes

	const overlayEl = document.getElementById('vhs');
	const canvasEl = document.getElementById('vhs-noise');
	if (!(overlayEl instanceof HTMLElement))
		throw new Error('VHS overlay not found');
	if (!(canvasEl instanceof HTMLCanvasElement))
		throw new Error('VHS canvas not found');
	const overlay: HTMLElement = overlayEl;
	const canvas: HTMLCanvasElement = canvasEl;

	const context = canvas.getContext('2d');
	if (!context) throw new Error('Canvas 2D context not available');
	const ctx: CanvasRenderingContext2D = context;

	let frame = 0;
	let fadeTimer: number | undefined;
	let done = false;

	// Tells the rest of the page the intro is over. Runs once.
	function complete() {
		if (done) return;
		done = true;
		document.documentElement.dataset.vhsDone = 'true';
		document.dispatchEvent(new CustomEvent('vhs:done'));
	}

	// Stops drawing and removes the overlay. Safe to call more than once.
	function cleanup() {
		cancelAnimationFrame(frame);
		window.clearTimeout(fadeTimer);
		overlay.remove();
	}

	// Skip: end everything immediately
	function skip() {
		cleanup();
		complete();
	}

	function startFade() {
		overlay.classList.add('fade');
		complete(); // typing starts while the static dissolves

		// Backup in case transitionend never fires
		window.setTimeout(cleanup, FADE_MS + 100);
	}

	function drawStatic() {
		const img = ctx.createImageData(canvas.width, canvas.height);
		const d = img.data;
		for (let i = 0; i < d.length; i += 4) {
			const v = Math.random() < 0.4 ? 0 : Math.random() ** 2 * 255;
			d[i] = v * 0.15; // red: low
			d[i + 1] = v; // green: full
			d[i + 2] = v * 0.3; // blue: low
			d[i + 3] = 255;
		}
		ctx.putImageData(img, 0, 0);
	}

	if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		cleanup();
		complete();
	} else {
		canvas.width = 320;
		canvas.height = 180;

		const draw = () => {
			drawStatic();
			frame = requestAnimationFrame(draw);
		};
		frame = requestAnimationFrame(draw);

		overlay.style.transitionDuration = `${FADE_MS}ms`;
		fadeTimer = window.setTimeout(startFade, STATIC_MS);

		overlay.addEventListener('transitionend', cleanup, { once: true });
		document.addEventListener('intro:skip', skip, { once: true });
	}
</script>

<div id="vhs" aria-hidden="true">
	<canvas id="vhs-noise"></canvas>
	<div class="scanlines"></div>
	<div class="tracking"></div>
</div>

<style>
	#vhs {
		position: fixed;
		inset: 0;
		z-index: 9999;
		background: var(--color-bg);
		pointer-events: none;
		transition-property: opacity;
		transition-timing-function: ease;
		/* duration is set from the script */
	}

	#vhs.fade {
		opacity: 0;
	}

	#vhs-noise {
		width: 100%;
		height: 100%;
		image-rendering: pixelated;
		opacity: 0.85;
	}

	.scanlines {
		position: absolute;
		inset: 0;
		background: repeating-linear-gradient(
			to bottom,
			rgba(0, 0, 0, 1) 0 1px,
			transparent 1px 3px
		);
	}

	.tracking {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 12%;
		background: linear-gradient(
			transparent,
			color-mix(in srgb, var(--color-text) 40%, transparent),
			transparent
		);
		animation: roll 3.5s linear infinite;
	}

	@keyframes roll {
		from {
			transform: translateY(-100%);
		}
		to {
			transform: translateY(100vh);
		}
	}
</style>

<script>
	// ---- Settings ----
	type Mode = 'green' | 'rainbow';
	const MODE = 'green' as Mode; // switch to 'rainbow' to compare
	const STATIC_MS = 1500; // how long the static plays
	const FADE_MS = 500; // how long the fade-out takes

	const overlay = document.getElementById('vhs')!;
	const canvas = document.getElementById('vhs-noise') as HTMLCanvasElement;
	const ctx = canvas.getContext('2d')!;

	let frame = 0;

	// Ends the intro and tells the rest of the page it's done
	function finish() {
		cancelAnimationFrame(frame);
		overlay.remove();
		document.documentElement.dataset.vhsDone = 'true';
		document.dispatchEvent(new CustomEvent('vhs:done'));
	}

	function drawGreen() {
		const img = ctx.createImageData(canvas.width, canvas.height);
		const d = img.data;
		for (let i = 0; i < d.length; i += 4) {
			const v = Math.random() < 0.4 ? 0 : Math.random() ** 2 * 255;
			d[i] = v * 0.15; // red: low
			d[i + 1] = v; // green: full
			d[i + 2] = v * 0.3; // blue: low
			d[i + 3] = 255;
		}
		ctx.putImageData(img, 0, 0);
	}

	function drawRainbow(time: number) {
		const { width, height } = canvas;
		const img = ctx.createImageData(width, height);
		const d = img.data;

		for (let y = 0; y < height; y++) {
			// Slowly drifting bands: 0 = blue-ish rows, 1 = pink-ish rows
			const band = (Math.sin(y * 0.15 + time * 0.003) + 1) / 2;
			let r = 0;
			let g = 0;
			let b = 0;

			for (let x = 0; x < width; x++) {
				// Only pick a new color sometimes; otherwise reuse the
				// previous pixel's color, which smears it sideways
				if (x === 0 || Math.random() < 0.3) {
					const n = Math.random();
					r = 80 + band * 140 + n * 60;
					g = n * 160 * (1 - band) + Math.random() * 40;
					b = 150 + (1 - band) * 80 + n * 40;
				}
				const i = (y * width + x) * 4;
				d[i] = r;
				d[i + 1] = g;
				d[i + 2] = b;
				d[i + 3] = 255;
			}
		}
		ctx.putImageData(img, 0, 0);
	}

	if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		finish();
	} else {
		// Rainbow uses a wide, short canvas so pixels stretch into streaks
		canvas.width = MODE === 'rainbow' ? 480 : 320;
		canvas.height = MODE === 'rainbow' ? 120 : 180;

		const draw = (time: number) => {
			if (MODE === 'rainbow') drawRainbow(time);
			else drawGreen();
			frame = requestAnimationFrame(draw);
		};
		frame = requestAnimationFrame(draw);

		overlay.style.transitionDuration = `${FADE_MS}ms`;
		setTimeout(() => overlay.classList.add('fade'), STATIC_MS);
		overlay.addEventListener('transitionend', finish, { once: true });
	}
</script>

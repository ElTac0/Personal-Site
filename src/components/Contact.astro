---
import GitHubIcon from './icons/GitHubIcon.astro';
import LinkedInIcon from './icons/LinkedInIcon.astro';
import { contactLinks, type ContactLink } from '../data/nav';

const icons: Record<ContactLink['icon'], typeof GitHubIcon> = {
	github: GitHubIcon,
	linkedin: LinkedInIcon,
};
---

<ul aria-label="Contact links" role="list">
	{contactLinks.map((item) => {
		const Icon = icons[item.icon];
		return (
			<li>
				<a
					href={item.href}
					target={item.external ? '_blank' : undefined}
					rel={item.external ? 'noopener noreferrer' : undefined}
				>
					<Icon />
					<span class="sr-only">
						{item.label}
						{item.external && ' (opens in new tab)'}
					</span>
				</a>
			</li>
		);
	})}
</ul>

<style>
	ul {
		display: flex;
		gap: 20px;
		list-style: none;
	}
	a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 20px;
	}
	a :global(svg) {
		display: block;
		width: 1.75rem;
		height: 1.75rem;
		filter: drop-shadow(0 0 4px currentColor);
	}

	a:hover,
	a:focus-visible {
		background-color: var(--color-highlight-bg);
		color: var(--color-highlight-text);
	}

	a:hover :global(svg),
	a:focus-visible :global(svg) {
		filter: none;
	}
</style>

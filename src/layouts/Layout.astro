---
import '@fontsource/vt323';
import '@fontsource/share-tech-mono';
import '../styles/global.css';
import CrtOverlay from '../components/CrtOverlay.astro';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = 'Izak — CS & Applied Math student. Projects, resume, and game reviews.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#050a06" />
	</head>
	<body>
		<CrtOverlay />
		<slot />
	</body>
</html>

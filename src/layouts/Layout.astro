---
import '../styles/global.css';
import '@fontsource/vt323';
import '@fontsource/share-tech-mono';
import CrtOverlay from '../components/CrtOverlay.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description='Izak — CS & Applied Math student. Projects, resume, and game reviews.' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content={'#050a06'} />
	</head>
	<body>
		<div class="screen">
			<CrtOverlay />
			<!-- nav -->
			<slot />

			<!-- footer -->

		</div>
	</body>
</html>